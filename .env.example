# Приложение
APP_NAME=anime-sync-api
DEBUG=false

# Строка подключения.
# В Docker собирается из POSTGRES_* (см. docker-compose.yml).
DATABASE_URL=postgresql+asyncpg://anime:anime@db:5432/anime
# Синхронный драйвер для Alembic (asyncpg не умеет sync-коннекты).
ALEMBIC_DATABASE_URL=postgresql+psycopg://anime:anime@db:5432/anime

# Локальный запуск без PostgreSQL:
# DATABASE_URL=sqlite+aiosqlite:///./anime.db
# ALEMBIC_DATABASE_URL=sqlite:///./anime.db

API_PREFIX=/api
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# Внешние источники
ANILIST_URL=https://graphql.anilist.co
JIKAN_URL=https://api.jikan.moe/v4
SYNC_BATCH_SIZE=50
REQUEST_TIMEOUT=20.0

# Только для docker-compose, не нужно в .env приложения
POSTGRES_USER=anime
POSTGRES_PASSWORD=anime
POSTGRES_DB=anime